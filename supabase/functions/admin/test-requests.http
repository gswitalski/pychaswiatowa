### Test Admin Endpoints
### Use REST Client extension in VS Code to execute these requests

@baseUrl = http://localhost:54331/functions/v1
@adminToken = YOUR_ADMIN_JWT_TOKEN_HERE
@userToken = YOUR_NON_ADMIN_JWT_TOKEN_HERE
@targetUserId = TARGET_USER_UUID_HERE

###############################################################################
### GET /admin/summary
###############################################################################

### SUMMARY-1. SUCCESS: Admin token
GET {{baseUrl}}/admin/summary
Authorization: Bearer {{adminToken}}

### SUMMARY-2. UNAUTHORIZED: Missing Authorization header
GET {{baseUrl}}/admin/summary

### SUMMARY-3. UNAUTHORIZED: Invalid token
GET {{baseUrl}}/admin/summary
Authorization: Bearer invalid_token_here

### SUMMARY-4. FORBIDDEN: Non-admin role
GET {{baseUrl}}/admin/summary
Authorization: Bearer {{userToken}}

### SUMMARY-5. METHOD NOT ALLOWED
POST {{baseUrl}}/admin/summary
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "unexpected": true
}

###############################################################################
### GET /admin/health
###############################################################################

### HEALTH-1. SUCCESS: Admin token
GET {{baseUrl}}/admin/health
Authorization: Bearer {{adminToken}}

### HEALTH-2. UNAUTHORIZED: Missing Authorization header
GET {{baseUrl}}/admin/health

### HEALTH-3. UNAUTHORIZED: Invalid token
GET {{baseUrl}}/admin/health
Authorization: Bearer invalid_token_here

### HEALTH-4. FORBIDDEN: Non-admin role
GET {{baseUrl}}/admin/health
Authorization: Bearer {{userToken}}

### HEALTH-5. METHOD NOT ALLOWED
DELETE {{baseUrl}}/admin/health
Authorization: Bearer {{adminToken}}

###############################################################################
### GET /admin/users
###############################################################################

### USERS-1. SUCCESS: Default query
GET {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}

### USERS-2. SUCCESS: Custom pagination and sorting
GET {{baseUrl}}/admin/users?page=2&page_size=10&sort_by=login&sort_dir=asc
Authorization: Bearer {{adminToken}}

### USERS-3. BAD REQUEST: Invalid page
GET {{baseUrl}}/admin/users?page=0
Authorization: Bearer {{adminToken}}

### USERS-4. BAD REQUEST: Invalid page_size
GET {{baseUrl}}/admin/users?page_size=101
Authorization: Bearer {{adminToken}}

### USERS-5. BAD REQUEST: Invalid sort_by
GET {{baseUrl}}/admin/users?sort_by=role
Authorization: Bearer {{adminToken}}

### USERS-6. BAD REQUEST: Invalid sort_dir
GET {{baseUrl}}/admin/users?sort_dir=up
Authorization: Bearer {{adminToken}}

### USERS-7. UNAUTHORIZED: Missing Authorization header
GET {{baseUrl}}/admin/users

### USERS-8. FORBIDDEN: Non-admin role
GET {{baseUrl}}/admin/users
Authorization: Bearer {{userToken}}

### USERS-9. METHOD NOT ALLOWED
POST {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "unexpected": true
}

###############################################################################
### GET /admin/recipes
###############################################################################

### RECIPES-1. SUCCESS: Default query
GET {{baseUrl}}/admin/recipes
Authorization: Bearer {{adminToken}}

### RECIPES-2. SUCCESS: Name sorting
GET {{baseUrl}}/admin/recipes?page=1&page_size=100&sort_by=name&sort_dir=asc
Authorization: Bearer {{adminToken}}

### RECIPES-3. SUCCESS: Author sorting
GET {{baseUrl}}/admin/recipes?sort_by=author&sort_dir=desc
Authorization: Bearer {{adminToken}}

### RECIPES-4. SUCCESS: Category sorting
GET {{baseUrl}}/admin/recipes?sort_by=category&sort_dir=asc
Authorization: Bearer {{adminToken}}

### RECIPES-5. SUCCESS: Created-at sorting
GET {{baseUrl}}/admin/recipes?sort_by=created_at&sort_dir=desc
Authorization: Bearer {{adminToken}}

### RECIPES-6. SUCCESS: Average rating sorting
GET {{baseUrl}}/admin/recipes?sort_by=average_rating&sort_dir=asc
Authorization: Bearer {{adminToken}}

### RECIPES-7. SUCCESS: Ratings count sorting
GET {{baseUrl}}/admin/recipes?sort_by=ratings_count&sort_dir=desc
Authorization: Bearer {{adminToken}}

### RECIPES-8. SUCCESS: Out-of-range page
GET {{baseUrl}}/admin/recipes?page=3000000000
Authorization: Bearer {{adminToken}}

### RECIPES-9. BAD REQUEST: Unsafe page
GET {{baseUrl}}/admin/recipes?page=9007199254740992
Authorization: Bearer {{adminToken}}

### RECIPES-10. BAD REQUEST: Invalid page size
GET {{baseUrl}}/admin/recipes?page_size=101
Authorization: Bearer {{adminToken}}

### RECIPES-11. BAD REQUEST: Invalid sort_by
GET {{baseUrl}}/admin/recipes?sort_by=updated_at
Authorization: Bearer {{adminToken}}

### RECIPES-12. NOT FOUND: Recipe child path
GET {{baseUrl}}/admin/recipes/1
Authorization: Bearer {{adminToken}}

### RECIPES-13. UNAUTHORIZED: Missing token
GET {{baseUrl}}/admin/recipes

### RECIPES-14. FORBIDDEN: Non-admin token
GET {{baseUrl}}/admin/recipes
Authorization: Bearer {{userToken}}

### RECIPES-15. METHOD NOT ALLOWED
POST {{baseUrl}}/admin/recipes
Authorization: Bearer {{adminToken}}

###############################################################################
### PATCH /admin/users/{userId}/role
###############################################################################

### ROLE-1. SUCCESS: Change role to premium
PATCH {{baseUrl}}/admin/users/{{targetUserId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "app_role": "premium"
}

### ROLE-2. BAD REQUEST: Invalid userId
PATCH {{baseUrl}}/admin/users/not-a-uuid/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "app_role": "user"
}

### ROLE-3. BAD REQUEST: Invalid app_role
PATCH {{baseUrl}}/admin/users/{{targetUserId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "app_role": "superadmin"
}

### ROLE-4. BAD REQUEST: Missing app_role
PATCH {{baseUrl}}/admin/users/{{targetUserId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{}

### ROLE-5. UNAUTHORIZED: Missing Authorization header
PATCH {{baseUrl}}/admin/users/{{targetUserId}}/role
Content-Type: application/json

{
  "app_role": "user"
}

### ROLE-6. FORBIDDEN: Non-admin role
PATCH {{baseUrl}}/admin/users/{{targetUserId}}/role
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "app_role": "user"
}

### ROLE-7. CONFLICT: Self role change (set targetUserId to admin own id)
PATCH {{baseUrl}}/admin/users/{{targetUserId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "app_role": "user"
}

### ROLE-8. NOT FOUND: Unknown user
PATCH {{baseUrl}}/admin/users/00000000-0000-4000-8000-000000000000/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "app_role": "user"
}

### ROLE-9. METHOD NOT ALLOWED
GET {{baseUrl}}/admin/users/{{targetUserId}}/role
Authorization: Bearer {{adminToken}}

###############################################################################
### Routing and CORS
###############################################################################

### ROUTE-1. NOT FOUND: Unknown path
GET {{baseUrl}}/admin/unknown
Authorization: Bearer {{adminToken}}

### ROUTE-2. OPTIONS preflight summary
OPTIONS {{baseUrl}}/admin/summary
Origin: http://localhost:4200
Access-Control-Request-Method: GET
Access-Control-Request-Headers: Authorization

### ROUTE-3. OPTIONS preflight health
OPTIONS {{baseUrl}}/admin/health
Origin: http://localhost:4200
Access-Control-Request-Method: GET
Access-Control-Request-Headers: Authorization

### ROUTE-4. OPTIONS preflight users
OPTIONS {{baseUrl}}/admin/users
Origin: http://localhost:4200
Access-Control-Request-Method: GET
Access-Control-Request-Headers: Authorization

### ROUTE-5. OPTIONS preflight user role update
OPTIONS {{baseUrl}}/admin/users/{{targetUserId}}/role
Origin: http://localhost:4200
Access-Control-Request-Method: PATCH
Access-Control-Request-Headers: Authorization, Content-Type

